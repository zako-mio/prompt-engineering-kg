digraph grp {
  rankdir=LR; bgcolor="transparent";
  node[shape=box, style="rounded,filled", fillcolor="#ffffff", color="#7c8aa5", fontcolor="#0e1729", fontname="Noto Sans CJK SC", fontsize=13, margin="0.20,0.12"]; edge[color="#7c8aa5", fontcolor="#46536b", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.7];
  n0 [label="指令层级\n(PE-A-01 · 第 2 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n1 [label="直接与间接提示词注入\n(PE-A-02 · 第 3 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n2 [label="大模型应用十大风险\n(PE-A-03 · 第 13 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n3 [label="过拒与安全—可用性权衡\n(PE-A-04 · 第 16 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n4 [label="负向提示的失效\n(PE-A-05 · 第 17 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n5 [label="不可信内容的标注与隔离\n(PE-A-06 · 第 18 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  {rank=same; n0; n1;}
  {rank=same; n2; n3;}
  {rank=same; n4; n5;}
  n1 -> n2 [style=invis, weight=100];
  n3 -> n4 [style=invis, weight=100];
  n0 -> n1 [constraint=false];
  n1 -> n2 [color="#7c8aa5"];
  n2 -> n3 [constraint=false];
  n3 -> n4 [color="#7c8aa5"];
  n4 -> n5 [constraint=false];
  stub_in [label="组外接口\n入 7 条", shape=note, style="filled", fillcolor="#e9eef8", color="#9a5310"];
  {rank=same; stub_in; n0; n1;}
  stub_in -> n0 [style=dashed, constraint=false, arrowhead=none];
  stub_in -> n2 [style=dashed, constraint=false, arrowhead=none];
  stub_in -> n3 [style=dashed, constraint=false, arrowhead=none];
  stub_in -> n5 [style=dashed, constraint=false, arrowhead=none];
  stub_out [label="组外接口\n出 3 条", shape=note, style="filled", fillcolor="#e9eef8", color="#9a5310"];
  {rank=same; stub_out; n4; n5;}
  n0 -> stub_out [style=dashed, constraint=false, arrowhead=none];
  n1 -> stub_out [style=dashed, constraint=false, arrowhead=none];
  n5 -> stub_out [style=dashed, constraint=false, arrowhead=none];
}
