digraph grp {
  rankdir=LR; bgcolor="transparent";
  node[shape=box, style="rounded,filled", fillcolor="#ffffff", color="#7c8aa5", fontcolor="#0e1729", fontname="Noto Sans CJK SC", fontsize=13, margin="0.20,0.12"]; edge[color="#7c8aa5", fontcolor="#46536b", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.7];
  n0 [label="交错输入\n(PE-V-01 · 第 9 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n1 [label="视觉推理链\n(PE-V-02 · 第 10 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n2 [label="位置敏感与注意力耗散\n(PE-V-03 · 第 11 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  {rank=same; n0;}
  {rank=same; n1;}
  {rank=same; n2;}
  n0 -> n1 [style=invis, weight=100];
  n1 -> n2 [style=invis, weight=100];
  n0 -> n1 [color="#7c8aa5"];
  n0 -> n2 [color="#7c8aa5"];
  stub_in [label="组外接口\n入 3 条", shape=note, style="filled", fillcolor="#e9eef8", color="#9a5310"];
  {rank=same; stub_in; n0;}
  stub_in -> n0 [style=dashed, constraint=false, arrowhead=none];
  stub_in -> n1 [style=dashed, constraint=false, arrowhead=none];
  stub_in -> n2 [style=dashed, constraint=false, arrowhead=none];
  stub_out [label="组外接口\n出 2 条", shape=note, style="filled", fillcolor="#e9eef8", color="#9a5310"];
  {rank=same; stub_out; n2;}
  n1 -> stub_out [style=dashed, constraint=false, arrowhead=none];
  n2 -> stub_out [style=dashed, constraint=false, arrowhead=none];
}
