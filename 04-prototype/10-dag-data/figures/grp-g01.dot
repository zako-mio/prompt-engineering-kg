digraph grp {
  rankdir=LR; bgcolor="transparent";
  node[shape=box, style="rounded,filled", fillcolor="#ffffff", color="#7c8aa5", fontcolor="#0e1729", fontname="Noto Sans CJK SC", fontsize=13, margin="0.20,0.12"]; edge[color="#7c8aa5", fontcolor="#46536b", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.7];
  n0 [label="结构模式与约束解码\n(PE-S-01 · 第 6 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n1 [label="三档严格度\n(PE-S-02 · 第 7 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n2 [label="推理与格式的冲突\n(PE-S-03 · 第 8 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n3 [label="格式选型与词元效率\n(PE-S-04 · 第 9 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n4 [label="校验与修复回路\n(PE-S-05 · 第 10 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  {rank=same; n0; n1;}
  {rank=same; n2; n3;}
  {rank=same; n4;}
  n1 -> n2 [style=invis, weight=100];
  n3 -> n4 [style=invis, weight=100];
  n0 -> n1 [constraint=false];
  n1 -> n2 [color="#7c8aa5"];
  n2 -> n3 [constraint=false];
  n3 -> n4 [color="#7c8aa5"];
  stub_in [label="组外接口\n入 1 条", shape=note, style="filled", fillcolor="#e9eef8", color="#9a5310"];
  {rank=same; stub_in; n0; n1;}
  stub_in -> n0 [style=dashed, constraint=false, arrowhead=none];
  stub_out [label="组外接口\n出 2 条", shape=note, style="filled", fillcolor="#e9eef8", color="#9a5310"];
  {rank=same; stub_out; n4;}
  n0 -> stub_out [style=dashed, constraint=false, arrowhead=none];
  n4 -> stub_out [style=dashed, constraint=false, arrowhead=none];
}
