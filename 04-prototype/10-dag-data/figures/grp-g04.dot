digraph grp {
  rankdir=LR; bgcolor="transparent";
  node[shape=box, style="rounded,filled", fillcolor="#ffffff", color="#7c8aa5", fontcolor="#0e1729", fontname="Noto Sans CJK SC", fontsize=13, margin="0.20,0.12"]; edge[color="#7c8aa5", fontcolor="#46536b", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.7];
  n0 [label="提示词链\n(PE-O-01 · 第 8 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n1 [label="路由\n(PE-O-02 · 第 9 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n2 [label="并行化与投票\n(PE-O-03 · 第 10 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n3 [label="编排者—工作者\n(PE-O-04 · 第 11 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n4 [label="生成者—评估者\n(PE-O-05 · 第 12 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n5 [label="状态机与持久化\n(PE-O-06 · 第 13 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n6 [label="子 Agent 上下文隔…\n(PE-O-07 · 第 14 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  n7 [label="工具定义与滥用治理\n(PE-O-08 · 第 15 层)", fillcolor="#dfe6fb", color="#2f4bd8"];
  {rank=same; n0; n1; n2;}
  {rank=same; n3; n4; n5;}
  {rank=same; n6; n7;}
  n2 -> n3 [style=invis, weight=100];
  n5 -> n6 [style=invis, weight=100];
  n0 -> n1 [constraint=false];
  n1 -> n2 [constraint=false];
  n2 -> n3 [color="#7c8aa5"];
  n3 -> n4 [constraint=false];
  n4 -> n5 [constraint=false];
  n5 -> n6 [color="#7c8aa5"];
  n6 -> n7 [constraint=false];
  stub_in [label="组外接口\n入 1 条", shape=note, style="filled", fillcolor="#e9eef8", color="#9a5310"];
  {rank=same; stub_in; n0; n1; n2;}
  stub_in -> n0 [style=dashed, constraint=false, arrowhead=none];
  stub_out [label="组外接口\n出 5 条", shape=note, style="filled", fillcolor="#e9eef8", color="#9a5310"];
  {rank=same; stub_out; n6; n7;}
  n2 -> stub_out [style=dashed, constraint=false, arrowhead=none];
  n4 -> stub_out [style=dashed, constraint=false, arrowhead=none];
  n5 -> stub_out [style=dashed, constraint=false, arrowhead=none];
  n7 -> stub_out [style=dashed, constraint=false, arrowhead=none];
}
